# Modelo do .env. Copie para ".env" e preencha.
#
# Nenhum destes valores é enviado a lugar nenhum além da própria API do
# Discord, que é quem os emite.

# Obrigatório em produção (NODE_ENV=production). Assina os tokens de sessão e
# de sala; qualquer string aleatória e longa serve.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# As três portas. Só a primeira importa para quem usa: é nela que o navegador
# bate, e quem atende ali roteia por caminho entre as outras duas. As outras
# existem porque app e servidor são processos separados — mudá-las só é preciso
# se algo mais na máquina já ocupa esses números.
PORT=3000
APP_PORT=3100
RELAY_PORT=3101

# Endereço público pelo qual o Discord (ou quem você convidar) alcança a porta
# de entrada. Precisa ser https:// fora de localhost.
PUBLIC_ORIGIN=http://localhost:3000

# Credenciais da aplicação em https://discord.com/developers/applications.
# Deixe em branco para rodar só no navegador, sem integração com o Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Opcional: token de bot, só para confirmar presença em canal de voz (escopo
# por call). Sem ele o escopo cai para a instância da Activity.
DISCORD_BOT_TOKEN=

# Teto de espectadores por transmissão (RF-AST-11). Padrão 12. A banda de
# subida cresce linearmente com quem assiste: a 8 Mbps o décimo espectador já
# pede 80 Mb/s de upload.
MAX_VIEWERS_PER_STREAM=

# Token do túnel, para subir com docker compose. Pegue em
# dash.cloudflare.com → Zero Trust → Networks → Tunnels → o seu → Configure.
# É o mesmo túnel do "npm run tunnel:create", visto pelo outro lado.
TUNNEL_TOKEN=

# Túnel da Cloudflare com endereço fixo. Preenchido por "npm run tunnel:create";
# vazio, o "npm run tunnel" abre um túnel descartável, com endereço novo a cada
# execução — e aí o Target no portal do Discord muda junto.
TUNNEL_CONFIG=

NODE_ENV=development

# Relatos de bug e feedback (botão "Enviar feedback"): vão para um canal do
# Discord pelo bot acima — o DISCORD_BOT_TOKEN passa a ser necessário para isto.
# O bot precisa estar no servidor e, no canal, poder Ver canal, Enviar mensagens,
# Anexar arquivos e Inserir links. Vazio = feedback desligado.
FEEDBACK_CHANNEL_ID=
FEEDBACK_GUILD_ID=
# Só para testes: aponta a API do Discord para um servidor falso.
# DISCORD_API_BASE=https://discord.com/api/v10
